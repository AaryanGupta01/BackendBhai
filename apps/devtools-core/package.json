{
  "name": "@backendbhai/devtools-core",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:standalone": "cross-env NO_DB=1 tsx watch src/index.ts",
    "build": "tsc && copyfiles -u 2 src/db/migrations/*.sql dist/db/migrations",
    "start": "node dist/index.js",
    "test": "vitest run",
    "seed": "tsx src/fixtures/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.1",
    "@fastify/websocket": "^8.3.1",
    "@opentelemetry/otlp-proto-exporter-base": "^0.51.1",
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.1",
    "pg": "^8.11.3",
    "protobufjs": "^8.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
